{
  "name": "bin-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Root commands for BIN frontend and backend",
  "scripts": {
    "install:all": "npm --prefix frontend ci && npm --prefix backend ci",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend test && npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test:integration": "npm --prefix frontend run test:integration && npm --prefix backend run test:edge",
    "backend:check": "npm --prefix frontend run backend:check",
    "bench:ui": "npm --prefix frontend run bench:ui",
    "audit:ui": "npm --prefix frontend run audit:ui",
    "preview": "npm --prefix frontend run preview",
    "db:test:isolated": "npm --prefix backend run db:test:isolated",
    "db:start": "npm --prefix backend run db:start",
    "db:stop": "npm --prefix backend run db:stop",
    "db:status": "npm --prefix backend run db:status",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:reset": "npm --prefix backend run db:reset",
    "db:test": "npm --prefix backend run db:test",
    "api:setup": "npm --prefix backend run api:setup",
    "api:auth": "npm --prefix backend run api:auth",
    "api:catalog": "npm --prefix backend run api:catalog",
    "api:gateway": "npm --prefix backend run api:gateway"
  }
}
